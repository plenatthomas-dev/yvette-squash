{
  "name": "yvette-squash",
  "version": "2.0.0",
  "private": true,
  "description": "Appli de réservation de terrains de squash (front amélioré + journal partagé) au-dessus de ResaMania",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run db:deploy:retry && next build",
    "start": "next start",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "vitest run --project node pg.test.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "npm run db:renumerote && prisma migrate deploy",
    "db:renumerote": "prisma db execute --schema prisma/schema.prisma --file prisma/renumerotation-migrations.sql",
    "db:renumerote:retour": "prisma db execute --schema prisma/schema.prisma --file prisma/renumerotation-migrations-retour.sql",
    "db:deploy:retry": "npm run db:deploy || (echo '↻ Base injoignable (branche Neon probablement archivee) : la tentative precedente a declenche son reveil, on repasse dans 25 s.' && sleep 25 && npm run db:deploy)",
    "db:studio": "prisma studio",
    "resa:test": "tsx scripts/resa-test.ts",
    "rankings:backfill": "node --env-file=.env --import tsx scripts/backfill-rankings.ts",
    "rankings:mois": "node --import tsx scripts/squashnet-months.ts",
    "rankings:diag": "node --env-file=.env --import tsx scripts/rankings-diagnostic.ts"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "@prisma/client": "^6.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "next": "^16.4.2",
    "nodemailer": "^10.1.1",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "prisma": "^6.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
